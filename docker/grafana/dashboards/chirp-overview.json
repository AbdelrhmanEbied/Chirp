{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Service Up/Down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{ job }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      }
    },
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(chirp_http_requests_total[5m])) by (service)",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(chirp_http_requests_total{status=~\"5..\"}[5m])) by (service) / sum(rate(chirp_http_requests_total[5m])) by (service) * 100",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      }
    },
    {
      "title": "P50/P95/P99 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(chirp_http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "p50 {{ service }}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(chirp_http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "p95 {{ service }}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(chirp_http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "p99 {{ service }}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "DB Query Latency P95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(chirp_db_query_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Events Published/s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(chirp_events_published_total[5m])) by (service, event_type)",
          "legendFormat": "{{ service }}: {{ event_type }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Event Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "chirp_event_queue_depth",
          "legendFormat": "{{ service }}: {{ stream }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Dependency Call Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sum(rate(chirp_dependency_requests_total[5m])) by (service, dependency, outcome)",
          "legendFormat": "{{ service }} -> {{ dependency }} ({{ outcome }})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "sum(rate(chirp_cache_operations_total{result=\"hit\"}[5m])) by (service) / (sum(rate(chirp_cache_operations_total[5m])) by (service) > 0) * 100",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["chirp"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Chirp Overview",
  "uid": "chirp-overview"
}
