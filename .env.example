# Copy to .env before running `make up`. Never commit .env.
# Every value here is a local-development default; nothing in this file is
# safe to reuse in a deployed environment.

# ---------------------------------------------------------------- shared
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# Signs and verifies access tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value-before-running
JWT_ALGORITHM=HS256
JWT_ISSUER=chirp.auth
JWT_AUDIENCE=chirp.api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REQUEST_MAX_BYTES=2097152

# ---------------------------------------------------------------- postgres
POSTGRES_USER=chirp
POSTGRES_PASSWORD=chirp-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------- redis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=60

# ---------------------------------------------------------------- events
# `redis` uses Redis Streams. `memory` is in-process and only useful in tests.
EVENT_BUS_BACKEND=redis
EVENT_STREAM_PREFIX=chirp.events
EVENT_MAX_DELIVERY_ATTEMPTS=5
EVENT_CLAIM_IDLE_MS=60000
EVENT_BATCH_SIZE=32
EVENT_MAX_STREAM_LENGTH=100000

# ---------------------------------------------------------------- pooling
# Per service instance. Ten services x 10 connections x N replicas has to stay
# under PostgreSQL's max_connections; see docs/scalability.md.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000
